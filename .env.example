# --- Server ---
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# --- Oracle DB ---
ORACLE_USER=transaction_app
ORACLE_PASSWORD=transactionpassword
ORACLE_CONNECT_STRING=localhost:1521/XEPDB1
ORACLE_POOL_MIN=2
ORACLE_POOL_MAX=10
ORACLE_POOL_INCREMENT=1

# --- MongoDB ---
MONGO_URI=mongodb://admin:adminpassword@localhost:27017/transaction_logs?authSource=admin

# --- RabbitMQ ---
RABBITMQ_URL=amqp://admin:adminpassword@localhost:5672
RABBITMQ_QUEUE_TRANSACTIONS=transactions.queue

# --- n8n ---
N8N_WEBHOOK_URL=http://localhost:5678/webhook/decision

# --- Auth (callback do n8n) ---
# Gere um valor proprio com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CALLBACK_AUTH_TOKEN=troque-por-um-segredo-forte
