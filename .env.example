# --- Server ---
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# --- Oracle DB ---
ORACLE_USER=transaction_app
ORACLE_PASSWORD=transactionpassword
ORACLE_CONNECT_STRING=localhost:1521/XEPDB1
ORACLE_POOL_MIN=2
ORACLE_POOL_MAX=10
ORACLE_POOL_INCREMENT=1

# --- MongoDB ---
MONGO_URI=mongodb://admin:adminpassword@localhost:27017/transaction_logs?authSource=admin

# --- RabbitMQ ---
RABBITMQ_URL=amqp://admin:adminpassword@localhost:5672
RABBITMQ_QUEUE_TRANSACTIONS=transactions.queue

# --- n8n ---
N8N_WEBHOOK_URL=http://localhost:5678/webhook/decision

# --- Auth (callback do n8n) ---
# Gere um valor proprio com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CALLBACK_AUTH_TOKEN=troque-por-um-segredo-forte

# --- Auth (clientes da API) ---
API_AUTH_TOKEN=troque-por-um-segredo-forte

# --- Rate limiting (por IP, em memoria) ---
# O teste de carga da Fase 9 excede estes valores de proposito; para reproduzir os
# numeros do LOAD-TEST.md, aumente RATE_LIMIT_MAX.
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000

# --- Auth (webhook de entrada do n8n) ---
N8N_WEBHOOK_TOKEN=troque-por-um-segredo-forte

# --- Transporte da decisao externa: 'http' (webhook) ou 'queue' (n8n consome a fila) ---
DECISION_TRANSPORT=queue

# Usados apenas para materializar a credencial RabbitMQ do n8n (modo 'queue').
# Dentro da rede do compose o host e o nome do servico, nao localhost.
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=adminpassword
