{
  "name": "transaction-system",
  "version": "1.0.0",
  "description": "Motor de Processamento Financeiro e de Estatisticas de Alta Volumetria (PoC)",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/server.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "amqplib": "^2.0.1",
    "dotenv": "^16.4.5",
    "fastify": "^5.10.0",
    "mongoose": "^8.5.2",
    "oracledb": "^7.0.1",
    "winston": "^3.13.1"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@types/oracledb": "7.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
